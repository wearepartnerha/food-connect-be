# Copy this file to .env and fill in the values. .env is git-ignored — never commit real secrets.

# --- Server ---------------------------------------------------------------------------------
PORT=4000

# Public base URL of this API, used to build the OAuth redirect URI. Optional locally (the
# request's origin is used); set it in production if the API sits behind a proxy.
API_URL=""

# Frontend origin(s) allowed to call this API (CORS), comma-separated. The first one is where
# users land after Google sign-in.
FRONTEND_URL="http://localhost:8080"

# --- MongoDB -------------------------------------------------------------------------------
# Connection string, e.g. from MongoDB Atlas (Database -> Connect -> Drivers).
MONGODB_URI=""
# Database name. Only needed when MONGODB_URI doesn't include one (Atlas URIs usually don't).
MONGODB_DB="food_waste_connect"

# --- Google sign-in (Google Cloud Console) --------------------------------------------------
# APIs & Services -> Credentials -> Create credentials -> OAuth client ID -> "Web application".
# Add this Authorized redirect URI (plus your production API URL's equivalent):
#   http://localhost:4000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Sessions & access ----------------------------------------------------------------------
# Random string (32+ chars) that signs session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""
# Comma-separated Google account emails that are granted admin access when they sign in.
ADMIN_EMAILS=""
